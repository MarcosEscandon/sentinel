# -*- mode: python ; coding: utf-8 -*-
"""PyInstaller >= 6 specification for Sentinel (Windows 10/11 x64).

It is not run directly: use ``packaging\\build.ps1``. If invoked manually:

    pyinstaller --noconfirm --clean packaging/sentinel.spec

Supported environment variables (set by build.ps1):

* ``SENTINEL_ONEFILE=1`` -> single executable (default).
  ``SENTINEL_ONEFILE=0`` -> directory mode (dist\\sentinel\\sentinel.exe).
* ``SENTINEL_CONSOLE=0`` -> no console (default).
  ``SENTINEL_CONSOLE=1`` -> visible console, useful for debugging.

Documented option to always build with a console: change the default value of
``CONSOLE`` below, or run ``.\\packaging\\build.ps1 -Console``.
The name ``name="sentinel"`` produces ``dist\\sentinel.exe`` on Windows.
"""

import glob
import os
from pathlib import Path

from PyInstaller.utils.hooks import collect_submodules

# SPECPATH is defined by PyInstaller; the fallback allows inspecting the spec
# with tools that do not inject that global (for example, py_compile).
_spec_dir = Path(globals().get("SPECPATH") or globals().get("__file__", ".")).resolve()
if _spec_dir.is_file():
    _spec_dir = _spec_dir.parent

PROJECT_ROOT = _spec_dir.parent  # packaging/ is inside the project root
BUILD_DIR = PROJECT_ROOT / "build"
DATA_DIR = PROJECT_ROOT / "sentinel" / "data"

# --- Helper files generated in build/ (text, not versioned) -----------------
# The declared entry point is sentinel.cli:main. We cannot use __main__.py as
# the root script because it contains relative imports; this launcher replicates
# exactly the behavior of the package's console_script.
BUILD_DIR.mkdir(parents=True, exist_ok=True)

launcher = BUILD_DIR / "sentinel_launcher.py"
launcher.write_text(
    '"""Launcher generated by packaging/sentinel.spec; do not edit."""\n'
    "from sentinel.cli import main\n\n"
    "raise SystemExit(main())\n",
    encoding="utf-8",
)

# In windowed mode, PyInstaller leaves sys.stdout/sys.stderr as None on Windows.
# argparse --version writes to stdout; without this hook the build smoke test
# would end with an AttributeError. With a visible console the hook is harmless.
runtime_hook = BUILD_DIR / "sentinel_windowed_stdio.py"
runtime_hook.write_text(
    '"""Hook generated by packaging/sentinel.spec; do not edit."""\n'
    "import os\n"
    "import sys\n\n"
    "if sys.platform == 'win32':\n"
    "    _output = open(os.devnull, 'w', encoding='utf-8')\n"
    "    _input = open(os.devnull, 'r', encoding='utf-8')\n"
    "    if sys.stdout is None:\n"
    "        sys.stdout = _output\n"
    "    if sys.stderr is None:\n"
    "        sys.stderr = _output\n"
    "    if sys.stdin is None:\n"
    "        sys.stdin = _input\n",
    encoding="utf-8",
)

# --- Packaging mode ----------------------------------------------------
ONEFILE = os.environ.get("SENTINEL_ONEFILE", "1") == "1"
CONSOLE = os.environ.get("SENTINEL_CONSOLE", "0") == "1"

# --- Package data ------------------------------------------------------
# Copied with the same structure used by sentinel.cli:
#   DATA_DIR = Path(__file__).parent / "data"
datas = []
for pattern, destination in (
    (str(DATA_DIR / "*.json"), "sentinel/data"),
    (str(DATA_DIR / "*.sig"), "sentinel/data"),
    (str(DATA_DIR / "*.pub"), "sentinel/data"),
    (str(DATA_DIR / "yara" / "*.yar"), "sentinel/data/yara"),
    (str(DATA_DIR / "iocs" / "*.csv"), "sentinel/data/iocs"),
    (str(DATA_DIR / "iocs" / "*.com"), "sentinel/data/iocs"),
):
    for source in sorted(glob.glob(pattern)):
        datas.append((source, destination))

if not any(Path(source).name == "signatures.json" for source, _ in datas):
    raise RuntimeError("Missing sentinel/data/signatures.json; check the project installation.")

# build.ps1 generates these files before invoking PyInstaller. They are packaged
# inside sentinel/data so they can be verified with `sentinel integrity verify`.
for name in ("manifest.json", "manifest.json.sig"):
    candidate = BUILD_DIR / name
    if candidate.is_file():
        datas.append((str(candidate), "sentinel/data"))

# --- Optional imports -----------------------------------------------------
# If the dependency is not installed, PyInstaller warns but does not fail.
hiddenimports = [
    "cryptography",
    "cryptography.exceptions",
    "cryptography.hazmat.primitives",
    "cryptography.hazmat.primitives.asymmetric.ed25519",
    "regex",
    "yara",
    "win32service",
    "servicemanager",  # pywin32 exposes 'servicemanager' (not 'win32servicemanager')
    "win32serviceutil",
    "watchdog",
    "tkinter",
]
for package in ("cryptography", "yara", "watchdog"):
    try:
        hiddenimports.extend(collect_submodules(package))
    except Exception:  # optional dependency absent from the build environment
        pass
hiddenimports = list(dict.fromkeys(hiddenimports))

# --- Exclusions ------------------------------------------------------------
# Do NOT exclude urllib/http/ssl/email (used by update_signatures) or sqlite3,
# lzma, zipfile or tarfile (history, containers and quarantine).
excludes = [
    "pytest",
    "_pytest",
    "ruff",
    "IPython",
    "jupyter",
    "notebook",
    "matplotlib",
    "numpy",
    "pandas",
    "scipy",
    "sklearn",
    "PIL",
    "cv2",
    "PyQt5",
    "PyQt6",
    "PySide2",
    "PySide6",
    "wx",
    "pip",
    "setuptools",
    "pkg_resources",
    "unittest",
    "doctest",
    "pydoc",
    "pydoc_data",
    "multiprocessing",
    "asyncio",
    "curses",
    "turtle",
    "lib2to3",
    "test",
    "tests",
]

# Optional icon: if you add packaging/sentinel.ico it will be used automatically.
icon_path = _spec_dir / "sentinel.ico"
icon = str(icon_path) if icon_path.is_file() else None

analysis = Analysis(
    [str(launcher)],
    pathex=[str(PROJECT_ROOT)],
    binaries=[],
    datas=datas,
    hiddenimports=hiddenimports,
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[str(runtime_hook)],
    excludes=excludes,
    noarchive=False,
)

pyz = PYZ(analysis.pure)

common_options = dict(
    name="sentinel",
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=True,
    upx_exclude=[],
    console=CONSOLE,
    disable_windowed_traceback=not CONSOLE,
    target_arch=None,
    codesign_identity=None,
    entitlements_file=None,
    icon=icon,
)

if ONEFILE:
    exe = EXE(
        pyz,
        analysis.scripts,
        analysis.binaries,
        analysis.datas,
        [],
        runtime_tmpdir=None,
        **common_options,
    )
else:
    exe = EXE(
        pyz,
        analysis.scripts,
        [],
        exclude_binaries=True,
        **common_options,
    )
    coll = COLLECT(
        exe,
        analysis.binaries,
        analysis.datas,
        strip=False,
        upx=True,
        upx_exclude=[],
        name="sentinel",
    )
